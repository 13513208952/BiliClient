<?xml version="1.0" encoding="utf-8"?>
<!--
    自定义 Media3 播放器控制条（biliclient 手机播放）。
    使用标准 exo_* id 让 Media3 自动接线播放/暂停/进度等；
    用 @+id/biliclient_settings 替换原生 exo_settings，
    避免 Media3 自己接管弹出原生设置菜单，由 Compose 层接管点击。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC000000"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- 进度条行 -->
    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:played_color="#FFFB7299"
        app:scrubber_color="#FFFB7299" />

    <!-- 控制按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 播放/暂停 -->
        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/exo_icon_play"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:contentDescription="播放/暂停" />

        <!-- 当前时间 -->
        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text=" / "
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <!-- 总时长 -->
        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:singleLine="true" />

        <!-- 弹性空间 -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 播放设置（我们的入口，Compose 层接线） -->
        <ImageButton
            android:id="@+id/biliclient_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_settings"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="播放设置" />

        <!-- 全屏 -->
        <ImageButton
            android:id="@id/exo_fullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/exo_icon_fullscreen_enter"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:contentDescription="全屏" />

    </LinearLayout>
</LinearLayout>
